// Crear cada medida por separado en FactVentas. Comas como separador DAX.
Ingreso neto = SUM(FactVentas[Ingreso_Neto])
Margen bruto = SUM(FactVentas[Margen_Bruto])
Margen % = DIVIDE([Margen bruto], [Ingreso neto])
Numero de ventas = DISTINCTCOUNT(FactVentas[Venta_ID])
Unidades = SUM(FactVentas[Unidades])
Ticket promedio = DIVIDE([Ingreso neto], [Numero de ventas])
Entregas aplicables = CALCULATE([Numero de ventas], KEEPFILTERS(FactVentas[Entrega_Aplica] = TRUE()))
Entregas tardias = COALESCE(CALCULATE([Numero de ventas], KEEPFILTERS(FactVentas[Estado_Entrega] = "Tardía")), 0)
Entregas tardias % = DIVIDE([Entregas tardias], [Entregas aplicables])
Tiempo medio entrega = AVERAGE(FactVentas[Tiempo_Entrega_Valido])
Satisfaccion media = AVERAGE(FactVentas[Satisfaccion_1_5])
Descuento total = SUM(FactVentas[Descuento_Valor])
Unidades por venta = DIVIDE([Unidades], [Numero de ventas])
Ventas recurrentes = CALCULATE([Numero de ventas], KEEPFILTERS(FactVentas[Tipo_Cliente] = "Recurrente"))
Actividad recurrente % = DIVIDE([Ventas recurrentes], [Numero de ventas])
